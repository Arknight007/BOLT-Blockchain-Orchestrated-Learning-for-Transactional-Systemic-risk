# --- secrets: never commit ---
.env
.env.*
!.env.example
*.key
*.pem

# --- data: raw responses are cached locally, never versioned ---
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep
*.parquet.tmp

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- solidity / node ---
node_modules/
artifacts/
cache/

# --- derived artefacts: regenerable, never versioned ---
# The frozen dataset (data/processed/panel.parquet) and its DATA_CARD.md ARE
# committed - they are the reproducibility contract. Everything below is
# regenerated by `bolt build` / `bolt train` and would only bloat clones.
outputs/*.npy
outputs/*.npz
outputs/eval_run.txt
outputs/train_run.txt
data/processed/models/
data/processed/windows.npz
data/processed/windows_meta.parquet

# --- runtime artefacts ---
outputs/bolt.log
outputs/*.log

# --- os ---
Thumbs.db
.DS_Store

# --- console / dev artefacts ---
outputs/shots/
outputs/serve_test.log
outputs/monitor_run.txt
