# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# BOLT reads every secret from the environment; nothing is ever written to a file
# or logged (BOLT_SPEC.md Section 9).

# --- ingestion (all optional; free tiers work without keys, but rate limits bite) ---
BOLT_COINGECKO_KEY=
BOLT_ETHERSCAN_KEY=
BOLT_CRYPTOPANIC_KEY=
BOLT_REDDIT_CLIENT_ID=
BOLT_REDDIT_CLIENT_SECRET=

# --- blockchain commitment layer, G5 (TESTNET ONLY: Polygon Amoy) ---
# Use a throwaway key funded only with Amoy test MATIC. Never a key with real value.
BOLT_RPC_URL=https://rpc-amoy.polygon.technology
BOLT_PRIVATE_KEY=
